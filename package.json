{
	"name": "winbit32-mcp",
	"version": "0.1.0",
	"description": "Agent-facing Winbit32: MCP + REST private-payments server. Accept USDC x402 and Monero/Zcash view-key payments; make co-signed ZEC payments (agent holds one FROST share, humans approve via WB32COSIGN QR). Built on viewkey-watch + x402-server-kit + @winbit32/wallet-kit.",
	"type": "module",
	"private": true,
	"license": "MIT",
	"homepage": "https://winbit32.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/FungeLLC/winbit32MCP.git"
	},
	"bin": {
		"gateway-rest": "bin/rest.mjs",
		"gateway-mcp": "bin/mcp.mjs",
		"gateway-private-watch-poller": "bin/private-watch-poller.mjs",
		"gateway-crypto-recv-poller": "bin/crypto-recv-poller.mjs"
	},
	"exports": {
		".": "./src/index.js",
		"./*": "./src/*.js"
	},
	"scripts": {
		"start:rest": "node bin/rest.mjs",
		"start:mcp": "node bin/mcp.mjs",
		"poll:watches": "node bin/private-watch-poller.mjs",
		"poll:crypto-recv": "node bin/crypto-recv-poller.mjs",
		"test": "node --experimental-vm-modules node_modules/.bin/jest",
		"test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch"
	},
	"dependencies": {
		"@coinbase/x402": "^2.1.0",
		"@fastify/cors": "^11.2.0",
		"@fastify/rate-limit": "^10.3.0",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@scure/bip39": "^2.2.0",
		"@winbit32/wallet-kit": "^0.2.0",
		"@x402/core": "^2.12.0",
		"@x402/evm": "^2.12.0",
		"@x402/extensions": "^2.12.0",
		"@x402/fastify": "^2.12.0",
		"@x402/paywall": "^2.12.0",
		"better-sqlite3": "^12.10.0",
		"fastify": "^5.8.5",
		"shamirs-secret-sharing": "^2.0.1",
		"viewkey-watch": "github:Rotwang9000/viewkey-watch#14b2c9c",
		"x402-server-kit": "github:Rotwang9000/x402-server-kit#bf5b97a",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@jest/globals": "^30.1.2",
		"jest": "^30.1.3",
		"supertest": "^7.1.4"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
