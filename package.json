{
	"name": "winbit32-mcp",
	"version": "0.2.0",
	"description": "The Winbit32 deployment of payments-gateway: MCP + REST private-payments server at mcp.winbit32.com. Accept USDC x402 and Monero/Zcash view-key payments; make co-signed ZEC payments (agent holds one FROST share, humans approve via WB32COSIGN QR / cosign deep link). The engine lives in Rotwang9000/payments-gateway — this repo is config, branding and deployment.",
	"type": "module",
	"private": true,
	"license": "MIT",
	"homepage": "https://winbit32.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/FungeLLC/winbit32MCP.git"
	},
	"bin": {
		"gateway-rest": "bin/rest.mjs",
		"gateway-mcp": "bin/mcp.mjs",
		"gateway-private-watch-poller": "bin/private-watch-poller.mjs",
		"gateway-crypto-recv-poller": "bin/crypto-recv-poller.mjs",
		"gateway-zec-shield-index-poller": "bin/zec-shield-index-poller.mjs"
	},
	"scripts": {
		"start:rest": "node bin/rest.mjs",
		"start:mcp": "node bin/mcp.mjs",
		"poll:watches": "node bin/private-watch-poller.mjs",
		"poll:crypto-recv": "node bin/crypto-recv-poller.mjs",
		"poll:zec-shield-index": "node bin/zec-shield-index-poller.mjs",
		"test": "node --experimental-vm-modules node_modules/.bin/jest",
		"test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch"
	},
	"dependencies": {
		"payments-gateway": "github:Rotwang9000/payments-gateway#9b42383",
		"viewkey-watch": "github:Rotwang9000/viewkey-watch#95e9332"
	},
	"devDependencies": {
		"@jest/globals": "^30.1.2",
		"jest": "^30.1.3"
	},
	"overrides": {
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
