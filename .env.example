# winbit32MCP example configuration — copy to .env (or export in your unit
# file) and fill in what you use. Every capability degrades gracefully:
# unset groups just don't register their tools/endpoints.

# ── Server ───────────────────────────────────────────────────────────
GATEWAY_REST_PORT=8820
GATEWAY_MCP_PORT=8821
GATEWAY_REST_HOST=127.0.0.1
GATEWAY_SERVICE_NAME=winbit32
# MCP tool-name prefix: winbit32_q, winbit32_make_payment, …
GATEWAY_TOOL_PREFIX=winbit32
#GATEWAY_WEBHOOK_SIGNATURE_HEADER=X-Winbit32-Signature

# ── x402 (accept USDC per call, Base) ────────────────────────────────
#X402_RECIPIENT_ADDRESS=0x...
#X402_NETWORK=base
#X402_FACILITATOR_URL=
#X402_CDP_API_KEY_ID=
#X402_CDP_API_KEY_SECRET=

# ── Hosted AI (prepaid credit bundles + OpenAI-compatible proxy) ─────
# Enabled when AI_UPSTREAM_API_KEY is set. The browser never sees this key:
# buyers pay one x402 USDC bundle at POST /v1/ai/credits and get a short-lived
# session token, which they spend at POST /v1/ai/chat/completions (the proxy
# meters tokens and debits the bundle). Requires X402_RECIPIENT_ADDRESS above.
#AI_UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
#AI_UPSTREAM_API_KEY=
#AI_DEFAULT_MODEL=openai/gpt-4o-mini
# Optional OpenRouter attribution (ignored by other upstreams):
#AI_UPSTREAM_REFERER=https://winbit32.com
#AI_UPSTREAM_TITLE=WinBit32 Messenger
# Comma list; empty = allow any model the upstream serves:
#AI_MODEL_ALLOWLIST=
# Public base URL returned to the client (it appends /chat/completions).
# Empty → derived from the request host.
#AI_PUBLIC_BASE_URL=https://mcp.winbit32.com/v1/ai
# Session DB — keep inside a systemd ReadWritePaths dir:
#AI_DB=/var/lib/winbit32mcp/ai-sessions.db
#AI_SESSION_TTL_SEC=2592000
# Bundle sizing (US cents) and per-token billing (atomic USDC, 6dp):
#AI_CREDIT_DEFAULT_USD_CENTS=500
#AI_CREDIT_MIN_USD_CENTS=50
#AI_CREDIT_MAX_USD_CENTS=2000
#AI_PRICE_PER_1K_INPUT_ATOMIC=1000
#AI_PRICE_PER_1K_OUTPUT_ATOMIC=3000
#AI_MIN_CALL_ATOMIC=200

# ── NFPT scanner (view-key watches + Zcash scan backend) ─────────────
#NFPT_BASE_URL=https://api.zcash.winbit32.com
#NFPT_API_KEY=

# ── Private watch store ──────────────────────────────────────────────
#PRIVATE_WATCH_DB=./private-watch.db
# 32-byte hex; REQUIRED to create watches:
#PRIVATE_WATCH_ENCRYPTION_KEY=

# ── Privacy-chain RPC (Penny Oracle `q` facts) ───────────────────────
#MONERO_RPC_URL=http://127.0.0.1:18081
#ZCASH_RPC_URL=http://127.0.0.1:8232

# ── Zcash shield-amount index ("blend in" popular amounts) ───────────
# Powers zec_amount_advice / zec_popular_amounts + GET /v1/zec/*. The
# read side is always on (falls back to a static blend-in set when empty);
# set ENABLED=1 + run bin/zec-shield-index-poller.mjs to populate live
# "N others used this" counts from the local Zebra node (no view keys).
#ZEC_SHIELD_INDEX_ENABLED=0
#ZEC_SHIELD_INDEX_DB=/var/lib/winbit32mcp/zec-shield-index.db
# Start height for the first scan (default: a recent NU5-era height).
#ZEC_SHIELD_INDEX_FROM_HEIGHT=
# Rolling window to keep fresh (0 = scan to tip from FROM_HEIGHT once).
#ZEC_SHIELD_INDEX_WINDOW_BLOCKS=0
#ZEC_SHIELD_INDEX_MAX_BLOCKS_PER_TICK=2000
# Ignore boundary crossings smaller than this (zatoshis; default 0.001 ZEC).
#ZEC_SHIELD_INDEX_MIN_BOUNDARY_ZAT=100000

# ── Zcash "Bus Station" — non-custodial mixing coordination (OPT-IN) ──
# Powers zec_bus_* + POST/GET /v1/zec/bus*. A rendezvous so many users leave
# the Zcash pool with the same blend-in amount/route in the same window (one
# anonymity set). NON-CUSTODIAL: holds no funds/keys, stores no destinations
# or txids. The tools + routes only appear when ENABLED=1 — a writable DB is
# required (no read-only fallback). Each rider broadcasts their OWN swap.
#ZEC_BUS_ENABLED=0
#ZEC_BUS_DB=/var/lib/winbit32mcp/zec-bus.db
#ZEC_BUS_FILL_TTL_MS=86400000
#ZEC_BUS_DEPART_WINDOW_MS=1200000
# Anti-sybil (P4c) — OFF by default. When on, claiming a seat REQUIRES a zk
# membership proof (one anonymous identity → one seat per bus) over the REST
# open→join flow; the MCP join tool then returns sybil_required. It needs a real
# trusted-setup ceremony verifying key (see the zecbus repo) — until that is
# wired the board stays open and anonymous. Enabling it WITHOUT a key fails safe
# (seats are refused, never silently opened).
#ZEC_BUS_SYBIL_REQUIRED=0
#ZEC_BUS_VERIFICATION_KEY=/var/lib/winbit32mcp/zec-bus-vkey.json

# ── XMR/ZEC top-ups (operator view-only receive wallets) ─────────────
#XMR_RECV_ADDRESS=
#XMR_RECV_VIEW_KEY=
#ZEC_RECV_ADDRESS=
#ZEC_RECV_UFVK=

# ── Donation overlay + Ziving (ziving.org) ───────────────────────────
#OVERLAY_PAGE_URL_BASE=https://ziving.org/overlay.html
#OVERLAY_MAX_PER_TICK=4
#ZIVING_PAGE_URL_BASE=https://ziving.org

# ── Make payments (co-signed shielded ZEC) ───────────────────────────
# The gateway's FROST share; make_payment tools only register when set.
#MAKE_PAYMENT_WULT_PATH=/etc/winbit32/vault-share.wult
#MAKE_PAYMENT_WULT_PASSWORD=
# Directory holding orchard_frost_wasm.js + orchard_frost_wasm_bg.wasm:
#MAKE_PAYMENT_WASM_DIR=/etc/winbit32/orchard-frost
#MAKE_PAYMENT_RELAY_URL=https://cosign.winbit32.com
#MAKE_PAYMENT_PCZT_API_BASE=
#MAKE_PAYMENT_SCANNER_BASE=
#MAKE_PAYMENT_BIRTHDAY_HEIGHT=
#MAKE_PAYMENT_MAX_ZEC=0.1
#MAKE_PAYMENT_MAX_PENDING=3
# Standalone cosigner page for clickable deep links (qrPayload goes in the
# URL hash). Default: https://winbit32.com/cosign.html
#COSIGN_APP_URL=https://winbit32.com/cosign.html
